# ============================================
# HaydenClaw Configuration
# ============================================

# --- Authentication (choose ONE method) ---

# Method 1: Claude Max subscription (recommended if you have Claude Pro/Max)
# Leave ANTHROPIC_API_KEY empty or set to "oauth"
# The agent will use your local Claude Code OAuth session
# ANTHROPIC_API_KEY=oauth

# Method 2: Anthropic API Key (pay-per-use)
# Get from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# --- Required ---
JWT_SECRET=change-me-to-random-string-at-least-16-chars

# --- Feishu (optional) ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- Agent ---
AGENT_MODE=process          # 'process' (recommended) or 'docker'
MAX_CONCURRENT_AGENTS=2
# ANTHROPIC_MODEL=sonnet    # Default model (sonnet/opus/haiku)

# --- Paths ---
DATABASE_PATH=./data/db/haydenclaw.db
IPC_BASE_DIR=./data/ipc
WORKSPACE_BASE_DIR=./data/workspaces

# --- Server ---
PORT=3000
LOG_LEVEL=info
