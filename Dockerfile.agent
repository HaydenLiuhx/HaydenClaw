# ==========================================
# HaydenClaw Agent Container
# ==========================================

FROM node:22-slim

# Install essential tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    jq \
    tree \
    ripgrep \
    fd-find \
    shellcheck \
    sqlite3 \
    chromium \
    fonts-liberation \
    fonts-noto-color-emoji \
    ffmpeg \
    imagemagick \
    poppler-utils \
    openssh-client \
    procps \
    locales \
    && rm -rf /var/lib/apt/lists/*

# Set locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# Chromium path
ENV AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Create non-root user
RUN groupadd -r agent && useradd -r -g agent -m -d /home/agent agent

# Setup workspace directories
RUN mkdir -p /workspace /data/ipc/input /home/agent/.claude \
    && chown -R agent:agent /workspace /data /home/agent

WORKDIR /app

# Install agent dependencies
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy built agent code
COPY dist/agent ./dist/agent
COPY dist/shared ./dist/shared

RUN chown -R agent:agent /app

USER agent

ENV NODE_ENV=production
ENV PATH="/home/agent/.local/bin:${PATH}"

ENTRYPOINT ["node", "dist/agent/runner.js"]
